# Government-liquidity candidate caches are workflow artifacts, never committed
cache/government/

# Local smoke-test/download artifacts. Candidate bundles promoted to production
# are tracked explicitly via cache/ and selected artifacts/ paths, not these
# ad hoc local files.
artifacts/external_*_features.parquet
artifacts/external_*_observations.parquet
artifacts/external_*_report.json
artifacts/external_sources_report.json
